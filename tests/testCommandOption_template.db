serverTestCommandOption_ds/TestserverTestCommandOption/DEVICE/otheroptionclass: "tango/test/servertestcommandoptionother"


# --- test/reference/server properties

# Both device instances map the write-only ChimeraTK::Void process variable with autoMapCommandsFromVoid="false",
# so it stays the boolean attribute of today.
