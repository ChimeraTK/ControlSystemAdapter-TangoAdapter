<?xml version="1.0" encoding="UTF-8" ?>
<deviceServer>
    <deviceClass name="testTangoServer">
        <deviceInstance name="tango/test/rejectcommandsourceascommand">
            <!-- The <command> element comes before the <attribute> element: the command declares the source first, so
                 the <attribute> which names the same source second is rejected. -->
            <command name="SourceAsCommand" inputArgument="INT/TO_DEVICE_SCALAR" />
            <attribute name="INT_TO_DEVICE_SCALAR" source="INT/TO_DEVICE_SCALAR" />
        </deviceInstance>
    </deviceClass>
</deviceServer>
