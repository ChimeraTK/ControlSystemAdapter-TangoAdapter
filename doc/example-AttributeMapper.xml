<?xml version="1.0" encoding="UTF-8"?>
<deviceServer>
    <deviceClass name="MD22">
        <description>DFMC-MD22 stepper motor</description>
        <deviceInstance name="test/md22/0">
            <import>/Motor1</import>
        </deviceInstance>
        <deviceInstance name="test/md22/1">
            <import>/Motor2</import>
        </deviceInstance>
    </deviceClass>
    <deviceClass name="MD22Controller">
        <title>MD22 Controller</title>
        <description>DFMC-MD22 stepper controller</description>
        <deviceInstance name="test/md22/controller" stateSource="/Motors/state" statusSource="/Motors/status">
            <attribute name="numberOfMotors" source="/Motors/nMotors">
                <description>The number of motors in this device server</description>
                <egu>n/a</egu>
                <eventing>off</eventing>
            </attribute>
            <attribute name="position" source="/Motors/position">
                <description>The current position of the motor</description>
                <egu>mm</egu>
                <eventing>change</eventing>
            </attribute>
            <attribute name="statusWord" source="/Motors/statusWord">
                <description>The status word of the controller</description>
                <egu>n/a</egu>
                <eventing>dataReady</eventing>
            </attribute>
            <attribute name="newDataTrigger" source="/Motors/newDataTrigger">
                <description>A Void register announcing that new data is available</description>
                <egu>n/a</egu>
                <eventing>change</eventing>
            </attribute>
            <command name="moveToPosition" inputArgument="/Motors/targetPosition" returnValue="/Motors/position">
                <inputDescription>The target position</inputDescription>
                <outputDescription>The position after the move</outputDescription>
            </command>
            <command name="stop" trigger="/Motors/stop" />
            <command inputArgument="/Motors/targetPosition" />
        </deviceInstance>
    </deviceClass>
</deviceServer>